<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/adminPanelFragment">

    <fragment
        android:id="@+id/adminPanelFragment"
        android:name="com.akj.adminpanelpopcart.Fragments.AdminPanelFragment"
        android:label="Admin Panel"
        tools:layout="@layout/fragment_admin_panel"
        >

        <action
            android:id="@+id/action_adminPanelFragment_to_viewUsersFragment"
            app:destination="@id/viewUsersFragment" />
        <action
            android:id="@+id/action_adminPanelFragment_to_addProductFragment"
            app:destination="@id/addProductFragment" />
        <action
            android:id="@+id/action_adminPanelFragment_to_viewProductsFragment"
            app:destination="@id/viewProductsFragment" />
        <action
            android:id="@+id/action_adminPanelFragment_to_allOrdersFragment"
            app:destination="@id/allOrdersFragment" />
    </fragment>

    <fragment
        android:id="@+id/addProductFragment"
        android:name="com.akj.adminpanelpopcart.Fragments.AddProductFragment"
        android:label="Add Product"
        tools:layout="@layout/fragment_add_product"/>

    <fragment
        android:id="@+id/viewProductsFragment"
        android:name="com.akj.adminpanelpopcart.Fragments.ViewProductFragment"
        android:label="View Products"
        tools:layout="@layout/fragment_view_product"/>



    <fragment
        android:id="@+id/viewUsersFragment"
        android:name="com.akj.adminpanelpopcart.Fragments.ViewUsersFragment"
        android:label="View Users"
        tools:layout="@layout/fragment_view_user"/>
    <fragment
        android:id="@+id/allOrdersFragment"
        android:name="com.akj.adminpanelpopcart.Fragments.AllOrdersFragment"
        android:label="AllOrdersFragment"
        tools:layout="@layout/fragment_all_orders"/>
</navigation>